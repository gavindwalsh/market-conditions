{# Market Pulse Dashboard — single self-contained page (§6). Data embedded as
   JSON; ECharts inlined. No external fetch (opens offline). #}
<meta charset="utf-8"/>{# without this, servers that omit the charset header
   get windows-1252 fallback and every ×/·/— renders as mojibake #}
<style>{{ css|safe }}</style>
<header class="masthead">
  {% if wordmark_data_uri %}<img class="wordmark" src="{{ wordmark_data_uri }}" alt="avos"/>{% else %}<span class="wordmark" style="font-family:Georgia,serif;font-size:22px">avos</span>{% endif %}
  <h1>Market Pulse</h1>
  <div class="range-btns">
    <button onclick="setRange(3,this)">3M</button><button onclick="setRange(6,this)">6M</button><button onclick="setRange(12,this)">1Y</button><button onclick="setRange(36,this)">3Y</button><button class="active" onclick="setRange(null,this)">All</button>
  </div>
  <div class="asof">Run {{ run_date }} ET · Phase {{ phase }}<br/>Data as-of block below each tile</div>
</header>

<div class="lead">{{ lead or "Daily aggregate pulse on US equity & options market structure, ownership, leverage, and health — each read in the context of its own history." }}</div>

{% for panel in panels %}
<section class="panel">
  <h2>{{ loop.index }}. {{ panel.title }}</h2>
  {% if panel.charts %}
  <div class="charts">
    {% for c in panel.charts %}
    <div class="chart-card">
      <div class="ctitle has-tip">{{ c.id }} · {{ c.name }}
        {% if c.badge %}<span class="badge badge-{{ c.badge }}">{{ c.badge_label or c.badge }}</span>{% endif %}
        {% if c.tip %}<span class="tip-icon">ⓘ</span>
        <div class="tip"><b>How to read it:</b> {{ c.tip }}<br/><i>Methodology: APPENDIX.md §{{ c.id }}</i></div>{% endif %}
        {% if not c.table %}<span class="expand-icon" data-chart="{{ c.id }}" role="button" tabindex="0" aria-label="Expand chart" title="Expand">⤢</span>{% endif %}
      </div>
      <div class="csrc">
        {% if c.value_fmt %}<b>{{ c.value_fmt }}</b>{% endif %}
        {% if c.percentile is not none %} · {{ c.percentile }}%ile{% endif %}
        · <span class="asof-stamp {{ 'stale' if c.stale else '' }}">as-of {{ c.asof }}</span>
        · {{ c.source }}
      </div>
      {% if c.table %}
      <div class="mtable-wrap"><table class="mtable">
        <thead><tr>{% for col in c.table.columns %}<th>{{ col }}</th>{% endfor %}</tr></thead>
        <tbody>{% for row in c.table.rows %}<tr>{% for cell in row %}<td>{{ cell }}</td>{% endfor %}</tr>{% endfor %}</tbody>
      </table></div>
      {% else %}
      <div class="chart" id="chart-{{ c.id }}"></div>
      {% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}
</section>
{% endfor %}

<footer>
  <div><b>Build</b> {{ build_version }} · run {{ run_ts }} ET · size target {{ size_budget }} MB</div>
  <div><b>Source status:</b> {{ source_status }}</div>
  <details class="glossary"><summary>Glossary</summary><dl>
    {% for g in glossary %}<dt>{{ g.term }}</dt><dd>{{ g.defn }}</dd>{% endfor %}
  </dl></details>
  <div>Every metric ID links to its DASHBOARD-SPEC.md section. Estimated/nowcast segments are dashed and labeled (§A9.5).</div>
</footer>

{# fullscreen chart overlay — one shared panel; boot script moves the chosen chart in/out #}
<div id="fs-overlay" class="fs-overlay" hidden>
  <div class="fs-panel">
    <div class="fs-head">
      <span class="fs-title"></span>
      <div class="fs-controls">
        <div class="range-btns fs-range">
          <button onclick="setRange(3,this)">3M</button><button onclick="setRange(6,this)">6M</button><button onclick="setRange(12,this)">1Y</button><button onclick="setRange(36,this)">3Y</button><button class="active" onclick="setRange(null,this)">All</button>
        </div>
        <button class="fs-close" aria-label="Close chart" title="Close (Esc)">✕</button>
      </div>
    </div>
    <div class="fs-src"></div>
    <div class="fs-body" id="fs-body"></div>
  </div>
</div>

<script>window.__PULSE__ = {{ data_json|safe }};</script>
{% if echarts_js %}<script>{{ echarts_js|safe }}</script>
<script>{{ chart_boot|safe }}</script>
{% else %}
<!-- ECharts not yet vendored: drop echarts.min.js in src/render/vendor/ to inline it (§6). Tiles render; charts are placeholders. -->
{% endif %}
